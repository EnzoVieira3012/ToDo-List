# =============================================================================
# To-Do List - Production Environment Variables
# =============================================================================
# Copy to .env and adjust values
# =============================================================================

# Application
COMPOSE_PROJECT_NAME=todo

# Database (PostgreSQL)
POSTGRES_DB=todo_db
POSTGRES_USER=todo_user
POSTGRES_PASSWORD=change_this_secure_password

# Backend
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost,https://yourdomain.com
LOGGING_LEVEL_COM_TODO=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=WARN

# Frontend
NGINX_HOST=localhost
NGINX_PORT=80

# pgAdmin (tools profile)
PGADMIN_EMAIL=admin@todo.local
PGADMIN_PASSWORD=change_this_admin_password

# =============================================================================
# Build Arguments (para docker build)
# =============================================================================
# VITE_API_BASE_URL=http://localhost:8080/api  # Injetado no build do frontend